{
  "expo": {
    "name": "Waits",
    "owner": "waits-app",
    "slug": "waits",
    "version": "1.0.0",
    "icon": "./assets/waits-app-icon.png",
    "orientation": "portrait",
    "scheme": "waits",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "ios": {
      "icon": "./assets/waits-app-icon.png",
      "supportsTablet": false,
      "bundleIdentifier": "com.waitsapp.waits",
      "deploymentTarget": "16.4",
      "usesAppleSignIn": true,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.waitsapp.waits"
    },
    "plugins": [
      "expo-router",
      "expo-apple-authentication",
      [
        "expo-build-properties",
        {
          "ios": {
            "deploymentTarget": "16.4",
            "useFrameworks": "dynamic"
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "eas": {
        "projectId": "82946543-3942-4ace-ae32-eda696b0147e"
      }
    }
  }
}
